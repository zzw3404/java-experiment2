<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%level %logger{35} - %msg%n</pattern><charset>UTF-8</charset></encoder>
  </appender>
  <logger name="study.enterprise.mis.EmployeeMapper" level="DEBUG"/>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
